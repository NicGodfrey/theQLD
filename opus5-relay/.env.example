# Cursor Cloud Agents API（仅部署在中转服务器，不要发给客户端）
CURSOR_API_KEY=crsr_your_key_here

# 客户端访问中转站用的令牌（物理电脑 / Claude Code 只持有这个）
RELAY_AUTH_TOKEN=change-me-to-a-long-random-string

# 服务端口
PORT=8787

# 可选：Opus 5 模型
# CURSOR_OPUS5_MODEL_ID=
# CURSOR_OPUS5_MODEL_PARAMS=

# 可选：创建 agent 时绑定的仓库
CURSOR_OPUS5_REPO_URL=https://github.com/NicGodfrey/theQLD
CURSOR_OPUS5_STARTING_REF=main

# 会话持久化目录
DATA_DIR=./data
