{
  "name": "session-gateway",
  "version": "1.0.0",
  "private": true,
  "description": "Session Gateway for a 10-slot GPT5.6 sol Cloud Agent pool with lease isolation, hard reset, billing, and full transcript retention.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "hot-start": "tsx scripts/hot-start.ts",
    "pool:status": "tsx scripts/pool-status.ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.4",
    "hono": "^4.8.5",
    "uuid": "^11.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.0.15",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
