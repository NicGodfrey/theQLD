# Required for create/follow-up/stream/usage/delete against Cloud Agents API
CURSOR_API_KEY=

# Shared secret for external clients calling this gateway
GATEWAY_API_KEY=change-me

# Pool / model
POOL_SIZE=10
WORKER_MODEL_ID=gpt-5.6-sol
WORKER_REASONING=xhigh
WORKER_CONTEXT=272k
WORKER_FAST=false
WORKER_NAME_PREFIX=GPT5.6 sol
REPO_URL=https://github.com/NicGodfrey/theQLD
REPO_REF=main

# Session lease
HEARTBEAT_TTL_MS=45000
HEARTBEAT_SWEEP_MS=5000

# Optional estimated USD (usage API is token-precise; dollars are config-based)
USD_PER_MILLION_INPUT_TOKENS=0
USD_PER_MILLION_OUTPUT_TOKENS=0

# Runtime
PORT=8787
DATA_DIR=./data
ORCHESTRATOR_URL=https://cursor.com/agents/bc-4c8e891e-d046-4919-a55a-eafe1e62dcea
