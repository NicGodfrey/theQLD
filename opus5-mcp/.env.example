# Cursor Cloud Agents API Key
# https://cursor.com/dashboard/api
CURSOR_API_KEY=crsr_your_key_here

# 可选：手动指定 Opus 5 模型 ID（默认自动从 /v1/models 解析）
# CURSOR_OPUS5_MODEL_ID=claude-opus-5-thinking
# CURSOR_OPUS5_MODEL_PARAMS=[{"id":"reasoning","value":"high"}]

# 可选：复用已有 agent 会话
# CURSOR_OPUS5_AGENT_ID=bc-xxxx

# 可选：创建 agent 时绑定仓库
# CURSOR_OPUS5_REPO_URL=https://github.com/NicGodfrey/theQLD
# CURSOR_OPUS5_STARTING_REF=main
